{
  "info": {
    "name": "Restful-Booker API QA Suite",
    "description": "Automated REST API test suite (CRUD + Token Auth + Negative 404 case) for Mateo Pimienta's QA Portfolio.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://restful-booker.herokuapp.com" },
    { "key": "token", "value": "" },
    { "key": "bookingid", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth - Create Token (POST /auth)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response contains auth token', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('token');",
              "    pm.collectionVariables.set('token', json.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\\n  \"username\": \"admin\",\\n  \"password\": \"password123\"\\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth", "host": ["{{baseUrl}}"], "path": ["auth"] }
      }
    },
    {
      "name": "2. List Bookings (GET /booking)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response time is below 2000ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
              "pm.test('Returns a non-empty booking array', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('array').that.is.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/booking", "host": ["{{baseUrl}}"], "path": ["booking"] }
      }
    },
    {
      "name": "3. Create Booking (POST /booking)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Booking created with bookingid and valid payload', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('bookingid');",
              "    pm.expect(json.booking.firstname).to.eql('Mateo');",
              "    pm.expect(json.booking.lastname).to.eql('Pimienta');",
              "    pm.collectionVariables.set('bookingid', json.bookingid);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\\n  \"firstname\": \"Mateo\",\\n  \"lastname\": \"Pimienta\",\\n  \"totalprice\": 250,\\n  \"depositpaid\": true,\\n  \"bookingdates\": {\\n    \"checkin\": \"2026-12-01\",\\n    \"checkout\": \"2026-12-05\"\\n  },\\n  \"additionalneeds\": \"Breakfast\"\\n}"
        },
        "url": { "raw": "{{baseUrl}}/booking", "host": ["{{baseUrl}}"], "path": ["booking"] }
      }
    },
    {
      "name": "4. Get Created Booking (GET /booking/:id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Retrieved data matches created booking', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.firstname).to.eql('Mateo');",
              "    pm.expect(json.totalprice).to.eql(250);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/booking/{{bookingid}}", "host": ["{{baseUrl}}"], "path": ["booking", "{{bookingid}}"] }
      }
    },
    {
      "name": "5. Update Booking (PUT /booking/:id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Price and additionalneeds updated successfully', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.totalprice).to.eql(320);",
              "    pm.expect(json.additionalneeds).to.eql('Breakfast and Wi-Fi');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Cookie", "value": "token={{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\\n  \"firstname\": \"Mateo\",\\n  \"lastname\": \"Pimienta\",\\n  \"totalprice\": 320,\\n  \"depositpaid\": true,\\n  \"bookingdates\": {\\n    \"checkin\": \"2026-12-01\",\\n    \"checkout\": \"2026-12-05\"\\n  },\\n  \"additionalneeds\": \"Breakfast and Wi-Fi\"\\n}"
        },
        "url": { "raw": "{{baseUrl}}/booking/{{bookingid}}", "host": ["{{baseUrl}}"], "path": ["booking", "{{bookingid}}"] }
      }
    },
    {
      "name": "6. Delete Booking (DELETE /booking/:id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cookie", "value": "token={{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/booking/{{bookingid}}", "host": ["{{baseUrl}}"], "path": ["booking", "{{bookingid}}"] }
      }
    },
    {
      "name": "7. Negative - Get Non-Existent Booking (GET /booking/999999999)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404 Not Found', function () { pm.response.to.have.status(404); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/booking/999999999", "host": ["{{baseUrl}}"], "path": ["booking", "999999999"] }
      }
    }
  ]
}
